index 00000000..05e91b4b
--- /dev/null
+++ b/tests/check-macos-band.sh
@@ -0,0 +1,6 @@
+#!/usr/bin/env bash
+set -uo pipefail
+BIN="$1"
+LINE="$("$BIN" --logo macos --pipe false 2>/dev/null | head -1 || true)"
+PAT="$(printf '\033[32m..\047')"
+! printf '%s' "$LINE" | grep -qF -- "$PAT"
