diff --git a/tests/check-listlogos.sh b/tests/check-listlogos.sh
new file mode 100755
index 00000000..9aaa9fdd
--- /dev/null
+++ b/tests/check-listlogos.sh
@@ -0,0 +1,11 @@
+#!/usr/bin/env bash
+set -uo pipefail
+BIN="$1"; KEY="$2"
+OUT="$("$BIN" --list-logos 2>/dev/null || true)"
+case "$KEY" in
+  nethydra)      grep -qF '"NetHydra"' <<<"$OUT" ;;
+  hydrapwk-gone) ! grep -qF '"HydraPWK"' <<<"$OUT" ;;
+  xinux)         grep -qF '"Xinux"' <<<"$OUT" ;;
+  deepin)        grep -qF '"deepin"' <<<"$OUT" ;;
+  *) echo "unknown key: $KEY" >&2; exit 2 ;;
+esac
diff --git a/tests/check-macos-band.sh b/tests/check-macos-band.sh
